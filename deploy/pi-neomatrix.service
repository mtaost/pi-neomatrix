[Unit]
Description=pi-neomatrix mobile display control service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/rpi/pi-neomatrix
ExecStart=/usr/bin/python3 /home/rpi/pi-neomatrix/main.py
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
